{
  "expo": {
    "name": "Lumenati",
    "slug": "lumenati",
    "scheme": "lumenati",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icons/icon.png",
    "splash": {
      "image": "./assets/icons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0e11"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lumenati.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pick a profile photo for your public room page.",
        "NSCameraUsageDescription": "Snap shelf photos to count inventory and receipts to log deductions.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Stripe needs your location to take secure Tap to Pay card payments."
      },
      "appleTeamId": "GBUTL2R6R6"
    },
    "android": {
      "package": "com.lumenati.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#0e0e11"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a profile photo for your public room page.",
          "cameraPermission": "Snap shelf photos to count inventory and receipts to log deductions."
        }
      ],
      "expo-notifications",
      "expo-build-properties",
      [
        "@stripe/stripe-terminal-react-native",
        {
          "locationWhenInUsePermission": "Stripe needs your location to take secure Tap to Pay card payments."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2f6cfbd9-beb5-4f36-a5ec-827c55c622d2"
      }
    },
    "owner": "cinebody"
  }
}