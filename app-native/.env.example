# Copy to .env. EXPO_PUBLIC_* values are inlined into the client bundle (safe:
# these are the same public Supabase values the web app already ships).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Where the Next API lives (used by later sub-sessions: Tap to Pay, payouts).
EXPO_PUBLIC_API_URL=https://lumenati-tattoo.vercel.app
