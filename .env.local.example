# Copy to .env.local and fill from the Supabase project:
# Dashboard -> Project Settings -> API
#
# Both are public/safe in the browser. Until they're set, the app runs on
# mock/localStorage data (no DB needed for local dev).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Square (read-only). SERVER-ONLY secret — never prefix with NEXT_PUBLIC.
# Square Developer dashboard -> your app -> Production -> Credentials ->
# Production Access Token. Until set, the dashboard runs on mock sales.
SQUARE_ACCESS_TOKEN=
# Optional: "production" (default) or "sandbox"
SQUARE_ENV=production

# Social — OPTIONAL. Without it, manual-submit still works but posts render as
# link cards (no thumbnail/caption auto-fetch). Format: "{app-id}|{client-token}"
# from a Meta developer app with the Instagram oEmbed Read product. SERVER-ONLY.
INSTAGRAM_OEMBED_TOKEN=
