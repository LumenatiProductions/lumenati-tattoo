# Copy to .env.local and fill from the Supabase project:
# Dashboard -> Project Settings -> API
#
# Both are public/safe in the browser. Until they're set, the app runs on
# mock/localStorage data (no DB needed for local dev).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Square (read-only). SERVER-ONLY secret — never prefix with NEXT_PUBLIC.
# Square Developer dashboard -> your app -> Production -> Credentials ->
# Production Access Token. Until set, the dashboard runs on mock sales.
SQUARE_ACCESS_TOKEN=
# Optional: "production" (default) or "sandbox"
SQUARE_ENV=production

# Social — OPTIONAL. Without it, manual-submit still works but posts render as
# link cards (no thumbnail/caption auto-fetch). Format: "{app-id}|{client-token}"
# from a Meta developer app with the Instagram oEmbed Read product. SERVER-ONLY.
INSTAGRAM_OEMBED_TOKEN=

# Stripe (POS arc — see POS-BUILD-PLAN.md). TEST keys first; no real charge until
# live keys are set intentionally. Until STRIPE_SECRET_KEY is set, the payment
# routes report "not configured" and the rest of the app is unaffected.
# Dashboard -> Developers -> API keys. SERVER-ONLY secret.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret. Local: `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` prints it. Prod: dashboard -> Webhooks.
STRIPE_WEBHOOK_SECRET=
# Public base URL Stripe returns to after Checkout (e.g. https://lumenati-tattoo.vercel.app).
# Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

# Kiosk device token (POS-STARTER-2). The /kiosk self-check-in iPad authorizes
# with this instead of a user login. Set any strong random string, then provision
# the iPad once (the /kiosk setup screen stores it). Until set, /kiosk is inert.
KIOSK_DEVICE_TOKEN=

# Auto no-show forfeit (POS-STARTER-4). The daily job only REPORTS no-show
# candidates until you opt in here, so it can't wrongly forfeit a real deposit.
# Set to 1 to actually forfeit held deposits for missed, un-checked-in bookings.
NO_SHOW_AUTOFORFEIT=
# Hours after the slot before a held deposit is a no-show candidate (default 24).
NO_SHOW_GRACE_HOURS=

# Vision / snap features (POS-STARTER-6, 6d). The app's "snap a receipt" and
# "snap to count" call Claude vision behind lib/vision/provider. SERVER-ONLY.
# (Pluggable: to default to Gemini Flash later, set GEMINI_API_KEY + implement
# the GeminiProvider swap point in lib/vision/provider.ts.)
ANTHROPIC_API_KEY=
